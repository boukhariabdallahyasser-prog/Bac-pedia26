{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bac-pedia26",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-11-16",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ],
    "html_handling": "auto-trailing-slash"
  },
  "observability": {
    "enabled": true
  },
  "workers_dev": true,
  "keep_vars": true
}
